<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Cocoar.SignalARRR.Client.FullFramework.Tests</AssemblyName>
    <RootNamespace>Cocoar.SignalARRR.Client.FullFramework.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <NoWarn>xUnit1051</NoWarn>
  </PropertyGroup>

  <!-- Shared with the integration test project: the same server-URL handshake, and the same race
       if it is guarded in only one of them. Linked rather than copied for exactly that reason. -->
  <ItemGroup>
    <Compile Include="..\Cocoar.SignalARRR.IntegrationTests\ServerUrlFile.cs" Link="ServerUrlFile.cs" />
    <Compile Include="..\Cocoar.SignalARRR.IntegrationTests\ServerUrlFileTests.cs" Link="ServerUrlFileTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Cocoar.SignalARRR.Client.FullFramework\Cocoar.SignalARRR.Client.FullFramework.csproj" />
  </ItemGroup>

</Project>
