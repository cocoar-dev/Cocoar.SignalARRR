<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>IntegrationTestServer</AssemblyName>
    <RootNamespace>IntegrationTestServer</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Cocoar.SignalARRR.Server\Cocoar.SignalARRR.Server.csproj" />
    <!-- Hubs and ServerMethods classes need the source generator, which produces their dispatch
         tables. It flows to package consumers through NuGet; a project reference needs it explicitly. -->
    <ProjectReference Include="..\..\Cocoar.SignalARRR.SourceGenerator\Cocoar.SignalARRR.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\Cocoar.SignalARRR.Server.Backplane.Redis\Cocoar.SignalARRR.Server.Backplane.Redis.csproj" />
    <ProjectReference Include="..\..\Cocoar.SignalARRR.Server.Backplane.Postgres\Cocoar.SignalARRR.Server.Backplane.Postgres.csproj" />
    <ProjectReference Include="..\Cocoar.SignalARRR.Tests.SharedModels\Cocoar.SignalARRR.Tests.SharedModels.csproj" />
    <ProjectReference Include="..\TestShared\TestShared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" />
  </ItemGroup>

</Project>
