<Project Sdk="Microsoft.NET.Sdk">

  <!-- NativeAOT smoke test of the .NET client: published with PublishAot and run against the
       IntegrationTestServer by scripts/run-aot-smoke.sh. It deliberately carries no
       TrimmerRootAssembly and no workaround beyond the app's own JsonSerializerContext, which is
       exactly what a real AOT app has to provide. Not part of the solution: it only means
       something when published, and the script does that. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
    <!-- Every trim/AOT warning on its own line, so the script can tell which assembly it came from. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- The script judges ILC warnings itself (only those from Cocoar.SignalARRR.* fail the run);
         as errors they would stop the publish before the run can show what else is broken. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Cocoar.SignalARRR.Client\Cocoar.SignalARRR.Client.csproj" />
    <ProjectReference Include="..\Cocoar.SignalARRR.Tests.SharedModels\Cocoar.SignalARRR.Tests.SharedModels.csproj" />
  </ItemGroup>

</Project>
