{
  "name": "@cocoar/signalarrr",
  "version": "4.0.0",
  "description": "TypeScript client for SignalARRR — type-safe RPC over SignalR",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "node scripts/copy-assets.cjs",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "files": [
    "dist/",
    "skills/",
    "scripts/"
  ],
  "author": "Bernhard Windisch",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cocoar-dev/Cocoar.SignalARRR.git",
    "directory": "src/Cocoar.SignalARRR.Typescript"
  },
  "homepage": "https://docs.cocoar.dev/signalarrr/",
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "@microsoft/signalr-protocol-msgpack": "^10.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
