<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 for the .NET Framework client, which uses the same generated proxies and
         dispatchers as the .NET client. -->
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>Cocoar.SignalARRR.ProxyGenerator</AssemblyName>
    <RootNamespace>Cocoar.SignalARRR.ProxyGenerator</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Trim and AOT analyzers on every net8.0+ target (warnings are errors): the .NET client runs
         under NativeAOT, and anything new that would break that fails the build here. -->
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Bernhard Windisch</Authors>
    <Company>-</Company>
    <Description>Runtime for SignalARRR's generated code — the proxy and dispatcher registries and the base classes the source generator's proxies and dispatchers build on.</Description>
    <PackageTags>signalr;rpc;signalarrr;proxy;codegen</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cocoar-dev/Cocoar.SignalARRR</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cocoar-dev/Cocoar.SignalARRR</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageId>Cocoar.SignalARRR.ProxyGenerator</PackageId>
    <Product>Cocoar.SignalARRR.ProxyGenerator</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reactive.Linq" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="System.Threading.Channels" />
  </ItemGroup>


</Project>
