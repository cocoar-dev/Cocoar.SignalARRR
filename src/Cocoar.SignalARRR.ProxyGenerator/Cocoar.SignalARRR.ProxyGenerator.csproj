<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Cocoar.SignalARRR.ProxyGenerator</AssemblyName>
    <RootNamespace>Cocoar.SignalARRR.ProxyGenerator</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Bernhard Windisch</Authors>
    <Company>-</Company>
    <Description>Proxy infrastructure for SignalARRR — factory registry and abstract dispatch base class for generated and dynamic proxies.</Description>
    <PackageTags>signalr;rpc;signalarrr;proxy;codegen</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cocoar-dev/Cocoar.SignalARRR</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cocoar-dev/Cocoar.SignalARRR</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageId>Cocoar.SignalARRR.ProxyGenerator</PackageId>
    <Product>Cocoar.SignalARRR.ProxyGenerator</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reactive.Linq" />
  </ItemGroup>


</Project>
