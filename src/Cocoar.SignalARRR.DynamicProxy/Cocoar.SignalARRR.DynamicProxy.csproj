<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Cocoar.SignalARRR.DynamicProxy</AssemblyName>
    <RootNamespace>Cocoar.SignalARRR.DynamicProxy</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Bernhard Windisch</Authors>
    <Company>-</Company>
    <Description>Dynamic proxy fallback for Cocoar.SignalARRR — uses DispatchProxy for runtime interface proxy generation. Opt-in package for scenarios where compile-time source generation is not available.</Description>
    <PackageTags>signalr;rpc;signalarrr;proxy;dispatchproxy;dynamic</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/windischb/SignalARRR</PackageProjectUrl>
    <RepositoryUrl>https://github.com/windischb/SignalARRR</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageId>Cocoar.SignalARRR.DynamicProxy</PackageId>
    <Product>Cocoar.SignalARRR.DynamicProxy</Product>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cocoar.SignalARRR.DynamicProxy.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Reactive.Linq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cocoar.SignalARRR.ProxyGenerator\Cocoar.SignalARRR.ProxyGenerator.csproj" />
  </ItemGroup>

</Project>
