<Project>

  <!--
    Copies SignalARRR Agent Skills to AI agent directories.
    Skills = SKILL.md (AI metadata) + docs/ (actual documentation as references/).
    Only runs if the target agent directory already exists (no folder pollution).
  -->

  <PropertyGroup>
    <_SignalARRRSkillsSource>$(MSBuildThisFileDirectory)skills\signalarrr\</_SignalARRRSkillsSource>
    <_SignalARRRDocsSource>$(MSBuildThisFileDirectory)docs\</_SignalARRRDocsSource>
  </PropertyGroup>

  <!-- Claude Code: .claude/skills/signalarrr/ -->
  <Target Name="_CopySignalARRRSkillsToClaude"
          AfterTargets="Build"
          Condition="Exists('$(MSBuildProjectDirectory)\.claude')">
    <ItemGroup>
      <_ClaudeSkillFiles Include="$(_SignalARRRSkillsSource)**\*" />
      <_ClaudeDocFiles Include="$(_SignalARRRDocsSource)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ClaudeSkillFiles)"
          DestinationFiles="@(_ClaudeSkillFiles->'$(MSBuildProjectDirectory)\.claude\skills\signalarrr\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ClaudeDocFiles)"
          DestinationFiles="@(_ClaudeDocFiles->'$(MSBuildProjectDirectory)\.claude\skills\signalarrr\references\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- GitHub Copilot: .github/skills/signalarrr/ -->
  <Target Name="_CopySignalARRRSkillsToGitHub"
          AfterTargets="Build"
          Condition="Exists('$(MSBuildProjectDirectory)\.github')">
    <ItemGroup>
      <_GitHubSkillFiles Include="$(_SignalARRRSkillsSource)**\*" />
      <_GitHubDocFiles Include="$(_SignalARRRDocsSource)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_GitHubSkillFiles)"
          DestinationFiles="@(_GitHubSkillFiles->'$(MSBuildProjectDirectory)\.github\skills\signalarrr\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_GitHubDocFiles)"
          DestinationFiles="@(_GitHubDocFiles->'$(MSBuildProjectDirectory)\.github\skills\signalarrr\references\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
