<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>Cocoar.SignalARRR.Server</AssemblyName>
    <RootNamespace>Cocoar.SignalARRR.Server</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- The netstandard2.0 source generator is referenced as an assembly (see the ProjectReference
         below) and brings Roslyn's System.Collections.Immutable, which conflicts with net8.0's own.
         The generator is never loaded at runtime, so the conflict is irrelevant. Consumers do not see
         it: they receive the generator as an analyzer, which assembly resolution never touches. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <!-- The backplane contracts (ISignalARRRBackplane, ISignalARRRConnectionRegistry,
         LocalSignalARRRBackplaneDispatcher, SignalARRRBackplaneBase, the envelope types) are
         internal on purpose: they are not a supported extension point yet. The Redis and Postgres
         backplanes ship as their own packages so that single-node consumers carry neither
         StackExchange.Redis nor Npgsql, and they reach those contracts from here. Promoting them
         to public API is a separate decision (review finding AF-3). -->
    <InternalsVisibleTo Include="Cocoar.SignalARRR.Server.Backplane.Redis" />
    <InternalsVisibleTo Include="Cocoar.SignalARRR.Server.Backplane.Postgres" />
    <InternalsVisibleTo Include="Cocoar.SignalARRR.IntegrationTests" />
    <InternalsVisibleTo Include="Cocoar.SignalARRR.Tests" />
    <InternalsVisibleTo Include="IntegrationTestServer" />
  </ItemGroup>

  <PropertyGroup>
    <Authors>Bernhard Windisch</Authors>
    <Company>-</Company>
    <Description>SignalARRR server library — typed bidirectional RPC over SignalR with authorization, streaming, server-to-client calls, and ServerMethods organization.</Description>
    <PackageTags>signalr;rpc;signalarrr;server;realtime;streaming;authorization</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cocoar-dev/Cocoar.SignalARRR</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cocoar-dev/Cocoar.SignalARRR</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageId>Cocoar.SignalARRR.Server</PackageId>
    <Product>Cocoar.SignalARRR.Server</Product>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cocoar.Reflectensions" />
    <PackageReference Include="Cocoar.Reflectensions.Invoke" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="System.Reactive.Linq" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\Cocoar.SignalARRR.Common\Cocoar.SignalARRR.Common.csproj" />
    <ProjectReference Include="..\Cocoar.SignalARRR.ProxyGenerator\Cocoar.SignalARRR.ProxyGenerator.csproj" />
    <ProjectReference Include="..\Cocoar.SignalARRR.Contracts\Cocoar.SignalARRR.Contracts.csproj" />
    <!-- The source generator reaches consumers as a dependency on the Cocoar.SignalARRR.SourceGenerator
         package, not as a copy of its DLL inside this one. Cocoar.SignalARRR.Client depends on the
         same package, so a project referencing both resolves it once and runs one generator; two
         bundled copies generated every proxy twice.
         NuGet leaves a ProjectReference with ReferenceOutputAssembly="false" out of the package's
         dependencies, so the generator is referenced as an assembly. Private="false" keeps it out of
         the build output and the package; nothing here uses its types, so the compiled DLL does not
         reference it either. PrivateAssets="compile;runtime" lets the analyzer flow to consumers
         while keeping the generator off their compile references, and off those of the projects in
         this repository that reference this one. -->
    <ProjectReference Include="..\Cocoar.SignalARRR.SourceGenerator\Cocoar.SignalARRR.SourceGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="true" Private="false" PrivateAssets="compile;runtime" />
  </ItemGroup>

  <!-- The Agent Skill (skills/signalarrr, generated from the docs by website/scripts/sync-skill.mjs)
       ships in a skills/ folder at the package root. Not under contentFiles on purpose: NuGet
       turns contentFiles into project items of every consumer, and 26 linked markdown files in
       each server project's Solution Explorer is noise nobody asked for. A root folder is
       invisible to consumers' builds and IDEs, and skill tooling finds it anyway
       (agentskills-cli add Cocoar.SignalARRR.Server, verified). Until 5.1 a .targets file copied
       the skill into every consumer's .claude/skills and .github/skills on each build — a silent
       write into their source tree, frozen at whatever the package had. -->
  <ItemGroup>
    <None Include="../../skills/signalarrr/**/*"
          Pack="true"
          PackagePath="skills/signalarrr/"
          Visible="false" />
  </ItemGroup>

</Project>
