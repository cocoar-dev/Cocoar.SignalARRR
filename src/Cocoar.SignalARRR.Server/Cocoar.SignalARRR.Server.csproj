<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Cocoar.SignalARRR.Server</AssemblyName>
    <RootNamespace>Cocoar.SignalARRR.Server</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Bernhard Windisch</Authors>
    <Company>-</Company>
    <Description>SignalARRR server library — typed bidirectional RPC over SignalR with authorization, streaming, server-to-client calls, and ServerMethods organization.</Description>
    <PackageTags>signalr;rpc;signalarrr;server;realtime;streaming;authorization</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/windischb/SignalARRR</PackageProjectUrl>
    <RepositoryUrl>https://github.com/windischb/SignalARRR</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageId>Cocoar.SignalARRR.Server</PackageId>
    <Product>Cocoar.SignalARRR.Server</Product>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cocoar.Reflectensions" />
    <PackageReference Include="Cocoar.Reflectensions.Invoke" />

    <PackageReference Include="System.Reactive.Linq" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\Cocoar.SignalARRR.Common\Cocoar.SignalARRR.Common.csproj" />
    <ProjectReference Include="..\Cocoar.SignalARRR.ProxyGenerator\Cocoar.SignalARRR.ProxyGenerator.csproj" />
    <ProjectReference Include="..\Cocoar.SignalARRR.Contracts\Cocoar.SignalARRR.Contracts.csproj" />
    <ProjectReference Include="..\Cocoar.SignalARRR.SourceGenerator\Cocoar.SignalARRR.SourceGenerator.csproj"
                       OutputItemType="Analyzer"
                       ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Pack .targets + skills + docs into buildTransitive so consuming projects get them -->
  <ItemGroup>
    <None Include="build/Cocoar.SignalARRR.Server.targets" Pack="true" PackagePath="buildTransitive/Cocoar.SignalARRR.Server.targets" />
    <None Include="../../skills/signalarrr/**/*" Pack="true" PackagePath="buildTransitive/skills/signalarrr/" />
    <None Include="../../docs/**/*" Pack="true" PackagePath="buildTransitive/docs/" />
  </ItemGroup>

</Project>
