<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>Cocoar.SignalARRR.Server</AssemblyName>
    <RootNamespace>Cocoar.SignalARRR.Server</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The backplane contracts (ISignalARRRBackplane, ISignalARRRConnectionRegistry,
         LocalSignalARRRBackplaneDispatcher, SignalARRRBackplaneBase, the envelope types) are
         internal on purpose: they are not a supported extension point yet. The Redis and Postgres
         backplanes ship as their own packages so that single-node consumers carry neither
         StackExchange.Redis nor Npgsql, and they reach those contracts from here. Promoting them
         to public API is a separate decision (review finding AF-3). -->
    <InternalsVisibleTo Include="Cocoar.SignalARRR.Server.Backplane.Redis" />
    <InternalsVisibleTo Include="Cocoar.SignalARRR.Server.Backplane.Postgres" />
    <InternalsVisibleTo Include="Cocoar.SignalARRR.IntegrationTests" />
    <InternalsVisibleTo Include="Cocoar.SignalARRR.Tests" />
    <InternalsVisibleTo Include="IntegrationTestServer" />
  </ItemGroup>

  <PropertyGroup>
    <Authors>Bernhard Windisch</Authors>
    <Company>-</Company>
    <Description>SignalARRR server library — typed bidirectional RPC over SignalR with authorization, streaming, server-to-client calls, and ServerMethods organization.</Description>
    <PackageTags>signalr;rpc;signalarrr;server;realtime;streaming;authorization</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cocoar-dev/Cocoar.SignalARRR</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cocoar-dev/Cocoar.SignalARRR</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageId>Cocoar.SignalARRR.Server</PackageId>
    <Product>Cocoar.SignalARRR.Server</Product>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cocoar.Reflectensions" />
    <PackageReference Include="Cocoar.Reflectensions.Invoke" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="System.Reactive.Linq" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\Cocoar.SignalARRR.Common\Cocoar.SignalARRR.Common.csproj" />
    <ProjectReference Include="..\Cocoar.SignalARRR.ProxyGenerator\Cocoar.SignalARRR.ProxyGenerator.csproj" />
    <ProjectReference Include="..\Cocoar.SignalARRR.Contracts\Cocoar.SignalARRR.Contracts.csproj" />
    <ProjectReference Include="..\Cocoar.SignalARRR.SourceGenerator\Cocoar.SignalARRR.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Pack .targets + skills + docs into buildTransitive so consuming projects get them -->
  <ItemGroup>
    <None Include="build/Cocoar.SignalARRR.Server.targets" Pack="true" PackagePath="buildTransitive/Cocoar.SignalARRR.Server.targets" />
    <None Include="../../skills/signalarrr/**/*" Pack="true" PackagePath="buildTransitive/skills/signalarrr/" />
  </ItemGroup>

  <!-- Bundle the SourceGenerator so consuming projects get proxy generation automatically -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\Cocoar.SignalARRR.SourceGenerator\bin\$(Configuration)\netstandard2.0\Cocoar.SignalARRR.SourceGenerator.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

</Project>
