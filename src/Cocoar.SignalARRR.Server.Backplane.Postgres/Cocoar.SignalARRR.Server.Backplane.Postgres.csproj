<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>Cocoar.SignalARRR.Server.Backplane.Postgres</AssemblyName>
    <RootNamespace>Cocoar.SignalARRR.Server</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cocoar.SignalARRR.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <Authors>Bernhard Windisch</Authors>
    <Company>-</Company>
    <Description>PostgreSQL backplane for SignalARRR — multi-node broadcasts, cluster-wide client queries and a distributed connection registry over LISTEN/NOTIFY, for deployments whose only stateful dependency is Postgres. Add this package only when running more than one server node.</Description>
    <PackageTags>signalr;rpc;signalarrr;server;backplane;postgres;postgresql;npgsql;scaleout</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cocoar-dev/Cocoar.SignalARRR</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cocoar-dev/Cocoar.SignalARRR</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageId>Cocoar.SignalARRR.Server.Backplane.Postgres</PackageId>
    <Product>Cocoar.SignalARRR.Server.Backplane.Postgres</Product>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built against the lowest Npgsql the backplane needs (NpgsqlDataSource and LISTEN/NOTIFY
         exist since 7), for every target framework: the package then asks for "Npgsql >= 8.0.6"
         and the application picks the version that fits the rest of its stack. The central
         version follows the target framework (10.0.3 on net10.0), which made the package demand
         Npgsql 10 there and blocked applications held on Npgsql 9 by Marten. The integration
         tests still run on the per-framework versions, so 8, 9 and 10 are all exercised. -->
    <PackageReference Include="Npgsql" VersionOverride="8.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cocoar.SignalARRR.Server\Cocoar.SignalARRR.Server.csproj" />
    <ProjectReference Include="..\Cocoar.SignalARRR.Common\Cocoar.SignalARRR.Common.csproj" />
  </ItemGroup>

</Project>
