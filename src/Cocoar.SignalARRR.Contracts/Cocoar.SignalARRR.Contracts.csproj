<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>Cocoar.SignalARRR.Contracts</AssemblyName>
    <RootNamespace>Cocoar.SignalARRR.Contracts</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Bernhard Windisch</Authors>
    <Company>-</Company>
    <Description>Contracts, attributes and source generator for SignalARRR proxy generation. Reference this package from any project that defines [SignalARRRContract] interfaces.</Description>
    <PackageTags>signalr;rpc;signalarrr;contracts;sourcegenerator;codegen</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cocoar-dev/Cocoar.SignalARRR</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cocoar-dev/Cocoar.SignalARRR</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageId>Cocoar.SignalARRR.Contracts</PackageId>
    <Product>Cocoar.SignalARRR.Contracts</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- ProxyGenerator flows transitively so generated code can compile (uses ProxyCreatorHelper) -->
    <ProjectReference Include="..\Cocoar.SignalARRR.ProxyGenerator\Cocoar.SignalARRR.ProxyGenerator.csproj" />
    <!-- [MessageName] lives in Common, and contract projects are documented as referencing Contracts
         alone. Without this the attribute would be unreachable in exactly the assemblies that
         declare contracts — the ones it exists for. -->
    <ProjectReference Include="..\Cocoar.SignalARRR.Common\Cocoar.SignalARRR.Common.csproj" />

    <!-- SourceGenerator runs as an analyzer in the consuming project -->
    <ProjectReference Include="..\Cocoar.SignalARRR.SourceGenerator\Cocoar.SignalARRR.SourceGenerator.csproj"
                       OutputItemType="Analyzer"
                       ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- NuGet packaging: bundle the source generator DLL as an analyzer -->
  <PropertyGroup>
    <DevelopmentDependency>false</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <IncludeBuildOutput>true</IncludeBuildOutput>
  </PropertyGroup>

  <!-- SourceGenerator is NOT bundled here — Contracts is for attributes only.
       The generator ships in the Server and Client packages where proxies are actually needed. -->

</Project>
