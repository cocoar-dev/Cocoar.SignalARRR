{
  "name": "cocoar-signalarrr-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-changelog.mjs && vitepress dev --host --port 5175",
    "dev:public": "node scripts/sync-changelog.mjs && vitepress dev --config .vitepress/config.public.ts --host --port 5175",
    "build": "node scripts/sync-changelog.mjs && vitepress build --config .vitepress/config.public.ts --outDir .vitepress/dist && node scripts/strip-dev-notes.mjs .vitepress/dist",
    "build:dev": "node scripts/sync-changelog.mjs && vitepress build --outDir .vitepress/dist-dev",
    "preview": "vitepress preview --config .vitepress/config.public.ts"
  },
  "devDependencies": {
    "mermaid": "^11.13.0",
    "vitepress": "^1.6.3",
    "vitepress-plugin-llms": "latest",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
